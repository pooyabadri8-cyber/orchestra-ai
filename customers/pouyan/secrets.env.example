# ---------- همیشه لازم ----------
# توکن رباتی که از @BotFather می‌گیرید
TELEGRAM_BOT_TOKEN=

# کانال هدف: یوزرنیم عمومی (مثلاً @pouyan_channel) یا شناسهٔ عددی (مثلاً -1001234567890)
# ربات باید در کانال «ادمین» با دسترسی «Post messages» باشد
TELEGRAM_CHANNEL=

# شناسهٔ عددی تلگرام شما (و هر کس دیگری که اجازهٔ تأیید پست دارد)، جداشده با ویرگول
# شناسه را از @userinfobot بگیرید
OWNER_IDS=

# ---------- مدل زبانی: فقط «یکی» از دو حالت زیر را پر کنید ----------

# حالت ۱) Claude (پولی) — کلید از console.anthropic.com
ANTHROPIC_API_KEY=

# حالت ۲) ارائه‌دهندهٔ رایگان — این چهار خط را از حالت کامنت دربیاورید و پر کنید:
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
#
# مثال Google Gemini (کلید رایگان از aistudio.google.com):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
#   (چند مدل با ویرگول: هر مدل سهمیهٔ رایگان جدا دارد؛ اگر اولی پر شد، ربات خودکار بعدی را امتحان می‌کند)
#
# مثال OpenRouter (کلید رایگان از openrouter.ai/keys، بدون کارت بانکی):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openrouter/free   (روتر رایگان؛ خودش یک مدل رایگان فعال را انتخاب می‌کند و با عوض شدن لیست مدل‌ها خراب نمی‌شود)

# اختیاری: ارائه‌دهندهٔ پشتیبان (هر سه مقدار را با هم پر کنید). اگر اصلی خطا داد، خودکار این استفاده می‌شود.
# LLM2_API_KEY=
# LLM2_BASE_URL=https://openrouter.ai/api/v1
# LLM2_MODEL=openrouter/free

# اختیاری: خواندن «گروه‌ها» با حساب تلگرام خودتان (راهنما در README، بخش گروه‌های تلگرام)
# از https://my.telegram.org ← API development tools بگیرید
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# توکن داشبورد (حداقل ۱۶ نویسه؛ مثلاً: openssl rand -hex 24). بدون آن داشبورد بالا نمی‌آید.
DASHBOARD_TOKEN=
