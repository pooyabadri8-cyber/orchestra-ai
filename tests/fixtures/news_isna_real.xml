      <category domain="tabriz">استان‌ها &gt; آذربایجان شرقی</category>
      <pubDate>Wed, 25 Nov 2026 11:23:21 GMT</pubDate>
      <guid>https://www.isna.ir/news/1405090402930/%D9%87%D8%B4%D8%AF%D8%A7%D8%B1-%D8%A7%D9%88%D8%B1%DA%98%D8%A7%D9%86%D8%B3-%D8%A2%D8%B0%D8%B1%D8%A8%D8%A7%DB%8C%D8%AC%D8%A7%D9%86-%D8%B4%D8%B1%D9%82%DB%8C-%D8%AF%D8%B1%D8%A8%D8%A7%D8%B1%D9%87-%D8%AE%D8%B7%D8%B1-%D9%85%D8%B3%D9%85%D9%88%D9%85%DB%8C%D8%AA-%D8%A8%D8%A7-%DA%AF%D8%A7%D8%B2-%D9%85%D9%88%D9%86%D9%88%DA%A9%D8%B3%DB%8C%D8%AF%DA%A9%D8%B1%D8%A8%D9%86</guid>
