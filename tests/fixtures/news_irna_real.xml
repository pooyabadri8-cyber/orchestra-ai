      <category domain="cinema_theater">فرهنگ &gt; سینما و تئاتر</category>
      <pubDate>Wed, 25 Nov 2026 11:22:55 GMT</pubDate>
      <guid>https://www.irna.ir/news/86331979/%D8%B4%D8%B9%D8%A8%D9%88%D9%86-%D8%AC%D8%B9%D9%81%D8%B1%DB%8C-%D8%A8%D9%87-%D8%AA%D8%A6%D8%A7%D8%AA%D8%B1%D8%B4%D9%87%D8%B1-%D9%85%DB%8C-%D8%A2%DB%8C%D8%AF-%D8%A7%D8%AC%D8%B1%D8%A7%DB%8C-%DB%B6-%D8%A7%D8%AB%D8%B1-%D8%A8%D8%A7-%D9%85%D9%88%D8%B6%D9%88%D8%B9-%DA%A9%D9%88%D8%AF%DA%A9%D8%A7%D9%86</guid>
    </item>
