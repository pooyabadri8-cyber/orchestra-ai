      <category domain="qazvin">استان‌ها &gt; قزوین</category>
      <pubDate>Wed, 25 Nov 2026 11:25:30 GMT</pubDate>
      <guid>https://www.irna.ir/news/86332421/%D9%85%D8%AF%DB%8C%D8%B1%DA%A9%D9%84-%D8%A8%D8%A7%D8%B2%D8%B1%D8%B3%DB%8C-%D8%A7%D8%B3%D8%AA%D8%A7%D9%86%D8%AF%D8%A7%D8%B1%DB%8C-%D9%82%D8%B2%D9%88%DB%8C%D9%86-%D8%B3%D8%A7%D9%85%D8%A7%D9%86%D9%87-%D9%81%D9%88%D8%A7%D8%AF-%D9%85%D9%86%D8%B4%D8%A7-%D9%86%D8%A7%D8%B1%D8%B6%D8%A7%DB%8C%D8%AA%DB%8C-%D8%B1%D8%A7-%D8%A7%D8%B5%D9%84%D8%A7%D8%AD</guid>
    </item>
