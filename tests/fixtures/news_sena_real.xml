      <category domain="video">چندرسانه‌ای &gt; صوت و فیلم</category>
      <pubDate>Mon, 23 Nov 2026 13:49:37 GMT</pubDate>
      <guid>https://www.sena.ir/news/97170/%D8%AF%D9%88%D9%85%DB%8C%D9%86-%D9%87%D9%85%D8%A7%DB%8C%D8%B4-%D8%B3%D8%A7%D9%84%D8%A7%D9%86%D9%87-%D8%A8%D8%A7%D8%B2%D8%A7%D8%B1-%D8%B3%D8%B1%D9%85%D8%A7%DB%8C%D9%87-%D8%AA%D8%B1%D8%B3%DB%8C%D9%85-%D8%A7%D9%81%D9%82-%D9%87%D8%A7%DB%8C-%D8%AA%D8%A7%D8%B2%D9%87-%D8%A8%D8%B1%D8%A7%DB%8C-%D8%A8%D8%A7%D8%B2%D8%A2%D9%81%D8%B1%DB%8C%D9%86%DB%8C</guid>
    </item>
    <item>
      <title>پنل تخصصی «تأمین مالی زنجیره ارزش از طریق بورس کالای ایران»</title>
