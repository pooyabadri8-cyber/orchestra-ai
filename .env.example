# Copy to .env and fill in. Never commit .env.
ORCHESTRA_DATABASE_URL=postgresql+psycopg://orchestra:orchestra@localhost:5432/orchestra
ORCHESTRA_SYSTEM_DATABASE_URL=postgresql://orchestra:orchestra@localhost:5432/orchestra_dbos
ORCHESTRA_ASSET_DIR=assets_store

# Language model for the writer. Option 1: Anthropic.
ORCHESTRA_LLM_PROVIDER=anthropic
ORCHESTRA_LLM_API_KEY=
ORCHESTRA_LLM_MODEL=claude-sonnet-5-5
# Option 2: any OpenAI-compatible endpoint (OpenRouter, Gemini, ...):
# ORCHESTRA_LLM_PROVIDER=openai_compatible
# ORCHESTRA_LLM_BASE_URL=https://openrouter.ai/api/v1
# ORCHESTRA_LLM_MODEL=

# Bot tokens, referenced by name from orgs/<org>/destinations.yaml (secret_env).
TELEGRAM_TEST_BOT_TOKEN=
BALE_TEST_BOT_TOKEN=
