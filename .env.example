# Copy to .env and fill in. Never commit .env.
ORCHESTRA_DATABASE_URL=postgresql+psycopg://orchestra:orchestra@localhost:5432/orchestra
ORCHESTRA_SYSTEM_DATABASE_URL=postgresql://orchestra:orchestra@localhost:5432/orchestra_dbos
ORCHESTRA_ASSET_DIR=assets_store

# Language model for the writer. Option 1: Anthropic.
ORCHESTRA_LLM_PROVIDER=anthropic
ORCHESTRA_LLM_API_KEY=
ORCHESTRA_LLM_MODEL=claude-sonnet-5-5
# Option 2: any OpenAI-compatible endpoint (OpenRouter, Gemini, ...):
# ORCHESTRA_LLM_PROVIDER=openai_compatible
# ORCHESTRA_LLM_BASE_URL=https://openrouter.ai/api/v1
# ORCHESTRA_LLM_MODEL=

# Bot tokens, referenced by name from orgs/<org>/destinations.yaml (secret_env).
TELEGRAM_TEST_BOT_TOKEN=
BALE_TEST_BOT_TOKEN=
INSTAGRAM_TEST_TOKEN=

# Optional: cheaper/faster models for the Manager and the reviewers (empty = ORCHESTRA_LLM_MODEL)
# ORCHESTRA_MANAGER_MODEL=
# ORCHESTRA_REVIEWER_MODEL=

# Instagram fetches slide images from a public address: a folder your web server publishes, and its URL
# ORCHESTRA_PUBLIC_ASSET_DIR=C:\inetpub\wwwroot\orchestra
# ORCHESTRA_PUBLIC_ASSET_URL=https://example.com/orchestra

# Control bot: give requests and approve from your phone (run_service.bat). Bale works without a VPN.
# 1) make a bot (@BotFather in Telegram or Bale) and put its token here
# 2) run run_service.bat, write anything to the bot: it tells you your numeric id; put it in CONTROL_CHAT_IDS
# ORCHESTRA_CONTROL_PLATFORM=bale
# ORCHESTRA_CONTROL_BOT_TOKEN=
# ORCHESTRA_CONTROL_CHAT_IDS=

# Foreign news sources (Telegram channels, foreign media) through your VPN's local proxy, if they do not connect:
# ORCHESTRA_FOREIGN_PROXY=http://127.0.0.1:10809      (or socks5://127.0.0.1:10808; capture_sources.bat shows which)

# Backups every night at 23:30 while the control bot runs. Best on ANOTHER disk, a USB drive, or a folder that
# OneDrive / Google Drive syncs (a backup on the same disk does not survive that disk failing).
# ORCHESTRA_BACKUP_DIR=D:\orchestra-backups
# ORCHESTRA_BACKUP_TIME=23:30
# ORCHESTRA_BACKUP_KEEP_DAYS=14
# ORCHESTRA_BACKUP_INCLUDE_ENV=false     (true also copies .env, which holds your tokens and keys)

# CRM: the public intake bot where applicants leave their details (a separate bot, not the control bot).
# Name and platform in orgs/<org>/crm.yaml (token_env).
# ORCHESTRA_INTAKE_BOT_TOKEN=
