# Copy to .env and fill in. Never commit .env.
ORCHESTRA_DATABASE_URL=postgresql+psycopg://orchestra:orchestra@localhost:5432/orchestra
ORCHESTRA_ASSET_DIR=assets_store

# Bot tokens are referenced by name from each destination (secret_env), so the database never stores a token.
TELEGRAM_TEST_BOT_TOKEN=
BALE_TEST_BOT_TOKEN=
